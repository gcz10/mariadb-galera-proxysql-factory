# Konfiguracja ansible-lint. Kazda pozycja ma uzasadnienie — lista wyjatkow bez
# powodu zamienia sie w smietnik, do ktorego dopisuje sie wszystko, co przeszkadza.

exclude_paths:
  - .ansible/            # kolekcje instalowane przez ansible-galaxy, nie nasz kod
  - .worktrees/          # rownolegle checkouty innych galezi

# Pliki w playbooks/ ktore NIE sa playbookami, tylko listami zadan wlaczanymi
# przez include_tasks. Bez tej klasyfikacji ansible-lint probuje je parsowac jak
# playbooki i zglasza syntax-check[specific] na braku klucza `hosts` — blad
# narzedzia, nie kodu. `playbooks/tasks/` trzyma helpery kanoniczne.
kinds:
  - tasks: "playbooks/tasks/*.yml"
  - tasks: "playbooks/f12_apply_patch.yml"
  - tasks: "playbooks/tls_certs.yml"

# UWAGA na przyszlosc: `syntax-check` jest w ansible-lint regula NIESKIPOWALNA.
# Wpisanie jej do `skip_list` nie wycisza znaleziska — wywala cale narzedzie
# bledem, a przy fladze `-q` wyglada to jak "0 naruszen". Probowalem; licznik
# spadl ze 135 na 0, co bylo nie sukcesem, tylko lintem, ktory sie nie uruchomil.

# yaml[line-length] wylaczony celowo. Zostaly po tym wlacznie dlugie
# wyrazenia Jinja (lancuchy lookup/selectattr/rejectattr w bramkach zdrowia
# i raportach PMM), jednolinijkowe komendy shell w skalarach YAML oraz
# dlugie URL-e/checksumy z lockfile. Lamanie ich to realne ryzyko zmiany
# semantyki: folded scalary (`>-`) wstawiaja spacje w miejscach zlaman,
# a wyrazenia Jinja nie znosza dowolnych podzialow — cichy blank w
# `{{ a | b }}` potrafi zepsuc bramke zdrowia, ktora pilnuje restartu.
# Zysk z limitu 160 znakow (domysl yamllint, nie wymog projektu) jest
# czysto wizualny, wiec handel jest zly. Pozostale podreguly `yaml`
# (empty-lines, comments itd.) zostaja aktywne.
skip_list:
  - yaml[line-length]
