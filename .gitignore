# Sekrety — nigdy do repo
clusters/*/secrets.yml
*.vault
*.pem
*.key
*.crt
tests/lab/.env

# Artefakty F0 i backupy
/var/tmp/f0-*
discovery-report-*.json

# Python/Ansible
__pycache__/
*.retry
*.pyc
.venv/
ssh_key
ssh_key.pub
# Materiał TLS (klucze, certy, katalogi per klaster) zostaje lokalnie, ale
# NARZĘDZIA do jego wytworzenia muszą być w repo. Wcześniej ignorowany był cały
# katalog, więc generate.sh nigdy nie trafił do wersjonowania: klaster z tls.mode=full
# odwoływał się w cluster.yml do plików, których nikt po sklonowaniu repo nie miał
# jak wytworzyć. Wzorzec `tests/lab/tls/*` (nie sam katalog) pozwala odwrócić
# wykluczenie dla skryptów; podkatalogi per klaster nadal są ignorowane w całości.
tests/lab/tls/*
!tests/lab/tls/*.sh
.secret-probe-*.yml
# Kolekcje instalowane przez ansible-galaxy (ANSIBLE_HOME wskazujacy na repo).
# Nieignorowane trafialy do `git ls-files --others` i sonda ISC-43 skanowala
# 3.5 tys. plikow upstreamu, zapalajac sie na ich fixturach testowych. W CI
# kolekcje ladowaly w ~/.ansible, wiec ta sama sonda przechodzila — werdykt
# zalezal od sciezki instalacji zaleznosci, nie od zawartosci repo.
.ansible/

# Terraform - stan, binarki providerów, plany (NIGDY do commita)
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfplan
# SSH known_hosts - artefakt klienta
clusters/**/known_hosts
clusters/*/known_hosts.old
# Wybrany wezel bootstrap po cold restarcie (artefakt playboku, odczytuje go Makefile)
clusters/*/restart-bootstrap-node

# Isolated execution worktrees
.worktrees/
