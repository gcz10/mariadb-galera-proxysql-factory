# Sekrety — nigdy do repo
clusters/*/secrets.yml
*.vault
*.pem
*.key
*.crt
tests/lab/.env

# Artefakty F0 i backupy
/var/tmp/f0-*
discovery-report-*.json

# Python/Ansible
__pycache__/
*.retry
*.pyc
.venv/
ssh_key
ssh_key.pub
# Poswiadczenia operatora: klucz SSH floty. Katalog jest ignorowany w calosci —
# nic w nim nie ma prawa trafic do wersjonowania.
secrets/
# Material TLS (klucze, certy, katalogi per klaster) zostaje lokalnie, ale
# NARZEDZIA do jego wytworzenia musza byc w repo. Wczesniej ignorowany byl caly
# katalog, wiec generate.sh nigdy nie trafil do wersjonowania: klaster z tls.mode=full
# odwolywal sie w cluster.yml do plikow, ktorych nikt po sklonowaniu repo nie mial
# jak wytworzyc. Wzorzec `pki/*` (nie sam katalog) pozwala odwrocic wykluczenie
# dla skryptow; podkatalogi per klaster nadal sa ignorowane w calosci.
pki/*
!pki/*.sh
.secret-probe-*.yml
# Kolekcje instalowane przez ansible-galaxy (ANSIBLE_HOME wskazujacy na repo).
# Nieignorowane trafialy do `git ls-files --others` i sonda ISC-43 skanowala
# 3.5 tys. plikow upstreamu, zapalajac sie na ich fixturach testowych. W CI
# kolekcje ladowaly w ~/.ansible, wiec ta sama sonda przechodzila — werdykt
# zalezal od sciezki instalacji zaleznosci, nie od zawartosci repo.
.ansible/

# Terraform - stan, binarki providerów, plany (NIGDY do commita)
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfplan
# SSH known_hosts - artefakt klienta
clusters/**/known_hosts
clusters/*/known_hosts.old
platform/**/known_hosts
platform/*/known_hosts.old
# Wybrany wezel bootstrap po cold recovery (artefakt playbooku, odczytuje go Makefile)
clusters/*/recover-bootstrap-node

# Isolated execution worktrees
.worktrees/

# macOS
.DS_Store

# Scratch procesu subagent-driven-development (ledger, briefy, raporty zadan)
.superpowers/

# Watchdog agenta: konfiguracja lokalna operatora, nie kontrakt repozytorium.
.omp/WATCHDOG.md
.omp/WATCHDOG.yml

# Katalogi tymczasowe testow bramki zaufania hostom (clusters/trust-*).
clusters/trust-*/
