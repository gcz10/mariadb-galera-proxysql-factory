{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cluster.yml schema",
  "description": "Schema konfiguracji klastra. Każda sekcja ma required + additionalProperties:false, żeby puste sekcje (np. proxysql: {}) NIE przechodziły walidacji.",
  "type": "object",
  "required": [
    "cluster",
    "platform",
    "versions",
    "galera",
    "proxysql",
    "tls",
    "network",
    "storage",
    "availability",
    "backup",
    "monitoring"
  ],
  "additionalProperties": false,
  "properties": {
    "cluster": {
      "type": "object",
      "required": [
        "name",
        "environment",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "laboratory"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "laboratory"
          ]
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "rocky_linux_major"
      ],
      "additionalProperties": false,
      "properties": {
        "rocky_linux_major": {
          "type": "integer",
          "enum": [
            9,
            10
          ]
        }
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "policy",
        "lock_file"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "locked",
            "candidate",
            "research-only"
          ]
        },
        "lock_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "galera": {
      "type": "object",
      "required": [
        "cluster_name",
        "nodes_expected"
      ],
      "additionalProperties": false,
      "properties": {
        "cluster_name": {
          "type": "string",
          "minLength": 1
        },
        "nodes_expected": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proxysql": {
      "type": "object",
      "required": [
        "nodes_expected",
        "endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes_expected": {
          "type": "integer",
          "minimum": 2
        },
        "hostgroup_base": {
          "type": "integer",
          "minimum": 10,
          "multipleOf": 10,
          "description": "Baza ID hostgroup ProxySQL: writer=base, backup=base+10, reader=base+20, offline=base+30. Domyślnie 10. Klastry dzielące jedną parę ProxySQL MUSZĄ mieć rozłączne bazy — inaczej f7_proxysql.yml drugiego klastra skasuje backendy pierwszego."
        },
        "app_user": {
          "type": "string",
          "minLength": 1,
          "description": "Nazwa użytkownika aplikacyjnego. Domyślnie app_user. mysql_users w ProxySQL jest tabelą globalną, a default_hostgroup tego wpisu wybiera klaster — na wspólnej parze ProxySQL nazwy MUSZĄ być rozłączne."
        },
        "frontend_tls": {
          "type": "object",
          "additionalProperties": false,
          "description": "Tozsamosc TLS WSPOLNEGO endpointu ProxySQL (port aplikacyjny). Kazdy klaster jest najemca warstwy wspolnej, wiec definicja klastra deklaruje WYLACZNIE ca_reference — komu ufa. Material frontendu (cert+klucz) wdraza platform/<name>/platform.yml; cert zapisany w definicji najemcy wiazalby zywotnosc endpointu calej floty z zyciem jednego klastra. additionalProperties:false odrzuca wiec tutaj certificate_reference/private_key_reference.",
          "required": [
            "ca_reference"
          ],
          "properties": {
            "ca_reference": {
              "type": "string",
              "minLength": 1,
              "description": "CA warstwy wspolnej, ktorym klient najemcy weryfikuje endpoint ProxySQL. Trafia na hosty aplikacyjne."
            }
          }
        },
        "endpoint": {
          "required": [
            "type",
            "address",
            "port"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "external_load_balancer",
                "keepalived_vip",
                "dns"
              ]
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "PLACEHOLDER"
              }
            },
            "port": {
              "type": "integer",
              "default": 6033
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "keepalived_vip"
                  }
                }
              },
              "then": {
                "properties": {
                  "address": {
                    "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "tls": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "full"
          ]
        },
        "ca_reference": {
          "type": "string"
        },
        "certificate_reference": {
          "type": "string"
        },
        "private_key_reference": {
          "type": "string"
        },
        "socket_dynamic": {
          "type": "boolean",
          "description": "Galera socket.dynamic — wezel przyjmuje jednoczesnie polaczenia szyfrowane i nieszyfrowane. Potrzebne WYLACZNIE na czas migracji dzialajacego klastra na TLS: bez niego wezel z socket.ssl nie polaczy sie z wezlami bez TLS. Procedura wymaga trzech rund rolling restartu (wlacz dynamic -> wlacz TLS -> wylacz dynamic). Zrodlo: mariadb.com/kb/en/wsrep_provider_options/#socketdynamic"
        },
        "require_secure_transport": {
          "type": "boolean"
        },
        "per_node_certificates": {
          "type": "boolean",
          "description": "Gdy true, kazdy wezel Galera dostaje WLASNY lisc i klucz spod wspolnego CA klastra (tests/lab/tls/issue-node-certs.sh, pliki node-<host>-cert.pem / node-<host>-key.pem obok ca.pem). Wyciek klucza z jednego wezla nie daje wtedy tozsamosci pozostalych, a lisc mozna wymienic pojedynczo. Gdy false lub brak — wszystkie wezly dziela jeden certyfikat wskazany przez certificate_reference."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "full"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "ca_reference",
              "certificate_reference",
              "private_key_reference"
            ]
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "required": [
        "application_cidrs",
        "database_cluster_cidrs",
        "administration_cidrs",
        "monitoring_cidrs"
      ],
      "additionalProperties": false,
      "properties": {
        "application_cidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "database_cluster_cidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "administration_cidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "monitoring_cidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "data_directory",
        "expected_database_size_gb"
      ],
      "additionalProperties": false,
      "properties": {
        "data_directory": {
          "type": "string"
        },
        "expected_database_size_gb": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "availability": {
      "type": "object",
      "required": [
        "rto_node_failure"
      ],
      "additionalProperties": false,
      "properties": {
        "rto_node_failure": {
          "type": "string"
        }
      }
    },
    "backup": {
      "type": "object",
      "required": [
        "enabled",
        "destination",
        "full_backup_schedule",
        "incremental_backup_schedule",
        "freshness_sla_hours",
        "retention_days",
        "encryption_enabled",
        "immutable_or_offsite_copy",
        "restore_test_schedule",
        "scheduler"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destination": {
          "type": "string",
          "enum": [
            "s3",
            "smb",
            "filesystem"
          ]
        },
        "full_backup_schedule": {
          "type": "string"
        },
        "incremental_backup_schedule": {
          "type": "string"
        },
        "freshness_sla_hours": {
          "type": "integer",
          "minimum": 1
        },
        "retention_days": {
          "type": [
            "integer",
            "string"
          ]
        },
        "encryption_enabled": {
          "type": "boolean"
        },
        "immutable_or_offsite_copy": {
          "type": "boolean"
        },
        "restore_test_schedule": {
          "type": "string"
        },
        "scheduler": {
          "type": "object",
          "required": [
            "mode",
            "host",
            "timezone"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "cron",
                "manual"
              ]
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "const": "UTC"
            }
          }
        },
        "s3": {
          "type": "object",
          "required": [
            "endpoint",
            "bucket"
          ],
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string"
            },
            "secure": {
              "type": "boolean"
            }
          }
        },
        "smb": {
          "type": "object",
          "required": [
            "source",
            "mount_point",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^//"
            },
            "mount_point": {
              "type": "string",
              "pattern": "^/"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "filesystem": {
          "type": "object",
          "required": [
            "mount_point",
            "expected_fstype"
          ],
          "additionalProperties": false,
          "properties": {
            "mount_point": {
              "type": "string",
              "pattern": "^/"
            },
            "expected_fstype": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "destination": {
                "const": "s3"
              }
            }
          },
          "then": {
            "required": [
              "s3"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "smb"
                  ]
                },
                {
                  "required": [
                    "filesystem"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "destination": {
                "const": "smb"
              }
            }
          },
          "then": {
            "required": [
              "smb"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "s3"
                  ]
                },
                {
                  "required": [
                    "filesystem"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "destination": {
                "const": "filesystem"
              }
            }
          },
          "then": {
            "required": [
              "filesystem"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "s3"
                  ]
                },
                {
                  "required": [
                    "smb"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "monitoring": {
      "type": "object",
      "required": [
        "pmm"
      ],
      "additionalProperties": false,
      "properties": {
        "pmm": {
          "type": "object",
          "required": [
            "server_url",
            "agent_id",
            "cluster_name",
            "validate_certs",
            "credentials_revision"
          ],
          "additionalProperties": false,
          "properties": {
            "server_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1
            },
            "cluster_name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "validate_certs": {
              "type": "boolean"
            },
            "credentials_revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "agent_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "galera",
              "restore"
            ]
          },
          "description": "Grupy hostow, ktore dostaja lokalnego pmm-agenta (pakiet pmm-client) zamiast domyslnego trybu agentless. Pusta lista = cala flota agentless. Grupy wezlow wspoldzielonych (proxysql, infra) celowo NIE wystepuja w enumie: rejestruje je wylacznie warstwa wspolna z platform/<name>/platform.yml, a najemca instalujacy agenta na cudzych wezlach zdublowalby eksportery postawione przez platforme."
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            },
            "folder_uid": {
              "type": "string"
            },
            "datasource_uid": {
              "type": "string"
            }
          }
        },
        "qan_source": {
          "type": "string",
          "enum": [
            "perfschema",
            "slowlog"
          ],
          "description": "Zrodlo danych QAN. 'slowlog' wymaga LOKALNEGO pmm-agenta (monitoring.agent_groups) czytajacego plik oraz mariadb_tuning.slow_query_log=ON; klaster agentless moze uzyc tylko 'perfschema'. Domyslnie perfschema."
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peak_qps": {
          "type": [
            "string",
            "number"
          ]
        },
        "peak_connections": {
          "type": [
            "string",
            "number"
          ]
        },
        "read_write_ratio": {
          "type": [
            "string",
            "number"
          ]
        },
        "largest_transaction_mb": {
          "type": [
            "string",
            "number"
          ]
        },
        "largest_table_gb": {
          "type": [
            "string",
            "number"
          ]
        },
        "expected_write_latency_ms": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "mariadb_tuning": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opcjonalne. gcache.size ustal z calc-gcache.py (ISC-68); pominięcie => bezpieczne 128M.",
      "properties": {
        "innodb_buffer_pool_size": {
          "type": "string"
        },
        "innodb_log_file_size": {
          "type": "string"
        },
        "max_connections": {
          "type": [
            "integer",
            "string"
          ]
        },
        "innodb_flush_log_at_trx_commit": {
          "type": [
            "integer",
            "string"
          ],
          "enum": [
            0,
            1,
            2,
            "0",
            "1",
            "2"
          ],
          "description": "Domyslnie 1 (flush przy COMMIT). 0/2 zwieksza wydajnosc kosztem trwalosci ostatnich transakcji; w production wymaga durability_risk_accepted=true."
        },
        "durability_risk_accepted": {
          "type": "boolean",
          "description": "Jawna, maszynowo sprawdzalna akceptacja ryzyka dla production z innodb_flush_log_at_trx_commit innym niz 1."
        },
        "gcache_page_size": {
          "type": "string"
        },
        "gcache_size": {
          "type": "string",
          "pattern": "^[0-9]+[MG]$"
        },
        "performance_schema": {
          "type": "string",
          "enum": [
            "ON",
            "OFF"
          ],
          "description": "Zrodlo danych dla QAN w PMM. MariaDB domyslnie ma OFF, przez co QAN jest pusty mimo dzialajacych agentow. Domyslnie ON; zmierzony koszt ~105 MB RAM na wezel przy domyslnym sizingu."
        },
        "slow_query_log": {
          "type": "string",
          "enum": [
            "ON",
            "OFF"
          ],
          "description": "Zrodlo QAN typu slowlog. Wymaga LOKALNEGO pmm-agenta (monitoring.agent_groups) — klaster agentless nie ma dostepu do pliku. Domyslnie OFF."
        },
        "long_query_time": {
          "type": "number",
          "minimum": 0,
          "description": "0 = loguj wszystkie zapytania (wymagane przez QAN slowlog). Domyslnie 10."
        },
        "wsrep_slave_threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Liczba watkow writesetow uzywana przez server.cnf.j2; domyslnie liczba vCPU wezla."
        },
        "wsrep_log_conflicts": {
          "type": "string",
          "enum": [
            "ON",
            "OFF"
          ],
          "description": "Rejestracja kolizji certyfikacji uzywana przez server.cnf.j2; domyslnie ON."
        },
        "wsrep_provider_options_extra": {
          "type": "string",
          "description": "Dodatkowe opcje wsrep providera (np. 'evs.suspect_timeout=PT5S;pc.weight=2;pc.recovery=1')."
        }
      }
    }
  }
}
