# Keepalived — redundantny endpoint ProxySQL (VIP).
# Generowany z repo (F8). Nie wpisuj danych klastra na stałe.
# VRRP unicast (nie zalezy od multicast, ktory w sieciach wirtualizowanych
# i chmurowych bywa filtrowany lub niedostepny).
# MASTER = proxysql_node_idx 1; pozostałe = BACKUP z niższym priorytetem.

global_defs {
    # Obie dyrektywy sa WYMAGANE: bez enable_script_security keepalived 2.x odmawia
    # uruchamiania skryptow ("SECURITY VIOLATION - scripts are being executed but
    # script_security not enabled") i raportuje je jako failed, nie wykonujac ich.
    enable_script_security
    script_user root
}

vrrp_script chk_proxysql {
    script "/usr/local/bin/check_proxysql.sh"
    interval 2
    weight 0  # audit#15: weight 0 → niezdrowy ProxySQL wprowadza instancję w FAULT (wycofuje VIP).
               # Wcześniej weight -60: przy awarii OBU ProxySQL MASTER (150-60=90) i tak trzymał VIP.
    fall 2
    rise 2
    timeout 3
}

vrrp_instance PROXYSQL_VIP {
    # OBA wezly startuja jako BACKUP — o roli decyduje priorytet, nie `state`.
    #
    # Wczesniej wezel 1 mial `state MASTER` i keepalived przy KAZDYM starcie
    # zglaszal do logu:
    #   "(PROXYSQL_VIP) Warning - preempt delay will not work with initial
    #    state MASTER - clearing"
    # Zrodlo tego zachowania jest jednoznaczne — keepalived/vrrp/vrrp.c:
    #   if (vrrp->wantstate == VRRP_STATE_MAST) { ... vrrp->preempt_delay = false; }
    # a man 5 keepalived.conf dodaje wprost: "NOTE: For this to work, the initial
    # state must not be MASTER."
    #
    # Skutek byl taki, ze `preempt_delay` dzialal WYLACZNIE na wezle 2, czyli tam,
    # gdzie nie ma znaczenia. Wezel 1 odbieral VIP natychmiast po powrocie —
    # zmierzone 7 s od `systemctl start proxysql`, przy zadeklarowanych 30 s.
    # Ochrona przed flappingiem istniala tylko w komentarzu.
    #
    # `state BACKUP` na obu kosztuje ~3,5 s dodatkowego czekania przy ZIMNYM
    # starcie calej pary (advertisement timeout), za cene realnie dzialajacego
    # opoznienia preempcji przy powrocie naprawionego wezla.
    state BACKUP
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ 150 if proxysql_node_idx | int == 1 else 100 }}
    advert_int 1
    # Powrót MASTERA nie może ściągać VIP natychmiast, aby zapobiec flappingowi przy awariach.
    preempt_delay {{ proxysql_endpoint_preempt_delay | default(30) }}
    # Gratuitous ARP — ochrona przed zatrutym/nieodswiezonym ARP na switchach/hypervisorach
    garp_master_delay 1
    garp_master_repeat 2
    garp_master_refresh 5
    garp_master_refresh_repeat 1
    unicast_src_ip {{ proxysql_node_address }}
    unicast_peer {
{% for peer in groups['proxysql'] if peer != inventory_hostname %}
        {{ hostvars[peer].proxysql_node_address }}
{% endfor %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ proxysql.endpoint.address }}/{{ keepalived_vip_prefix }} dev {{ keepalived_interface }}
    }

    track_script {
        chk_proxysql
    }
}
