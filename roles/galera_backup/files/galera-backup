            existing = list(
                self.client.list_objects(
                    self.bucket,
                    prefix=prefix,
                    recursive=True,
                )
            )
        except Exception as exc:
            raise BackupError(
                "E_STORAGE",
                f"Failed to check S3 destination prefix '{prefix}': {exc}",
            ) from exc
