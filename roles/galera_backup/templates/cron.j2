# /etc/cron.d/galera-backup-{{ cluster.name }}
CRON_TZ={{ backup.scheduler.timezone | default('UTC') }}
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

{{ backup.full_backup_schedule }} root systemd-cat -t galera-backup /opt/galera-backup/galera-backup backup {{ cluster.name }} >/dev/null 2>&1
