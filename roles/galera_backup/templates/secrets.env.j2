{% if (galera_backup_local_role | default('scheduler')) == 'scheduler' and galera_backup_proxysql_stats_password is defined and galera_backup_proxysql_stats_password %}
GALERA_BACKUP_PROXYSQL_STATS_USER="{{ galera_backup_proxysql_stats_user | default(proxysql_stats_user | default('isa_stats')) }}"
GALERA_BACKUP_PROXYSQL_STATS_PASSWORD="{{ galera_backup_proxysql_stats_password }}"
{% endif %}
GALERA_BACKUP_ENCRYPTION_KEY="{{ galera_backup_resolved_shared_secrets.encryption_key }}"
{% if backup.destination == 's3' %}
GALERA_BACKUP_S3_ACCESS_KEY="{{ galera_backup_resolved_shared_secrets.s3_access_key }}"
GALERA_BACKUP_S3_SECRET_KEY="{{ galera_backup_resolved_shared_secrets.s3_secret_key }}"
{#
  Poswiadczenie retencji trafia WYLACZNIE na koordynatora (backup.scheduler.host).
  Klucz zapisu powyzej lezy na kazdym wezle Galery, bo donora wybiera runner przy
  starcie — dlatego prawo kasowania kopii jest tu odciete od prawa ich zapisu.
  Host restore nigdy nie jest koordynatorem, wiec nie dostaje delete.
#}
{% if inventory_hostname == backup.scheduler.host
      and galera_backup_resolved_shared_secrets.s3_prune_access_key | default('') %}
GALERA_BACKUP_S3_PRUNE_ACCESS_KEY="{{ galera_backup_resolved_shared_secrets.s3_prune_access_key }}"
GALERA_BACKUP_S3_PRUNE_SECRET_KEY="{{ galera_backup_resolved_shared_secrets.s3_prune_secret_key }}"
{% endif %}
{% elif backup.destination == 'smb' %}
GALERA_BACKUP_SMB_USERNAME="{{ galera_backup_resolved_shared_secrets.smb_username }}"
GALERA_BACKUP_SMB_PASSWORD="{{ galera_backup_resolved_shared_secrets.smb_password }}"
{% if galera_backup_resolved_shared_secrets.smb_domain %}
GALERA_BACKUP_SMB_DOMAIN="{{ galera_backup_resolved_shared_secrets.smb_domain }}"
{% endif %}
{% endif %}
