{#
  Polityka poswiadczenia DONORA. Lezy na kazdym wezle Galery, bo donora wybiera
  runner przy starcie — dlatego NIE MA tu zadnej akcji `s3:Delete*`. Kasowanie
  wygaslych kopii nalezy do osobnego poswiadczenia retencji
  (`minio-policy-prune.json.j2`), ktore Ansible wysyla wylacznie na host
  `backup.scheduler.host`. Kontrakt pilnuje tests/unit/test_backup_delete_separation.py.
#}
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::{{ backup.s3.bucket }}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::{{ backup.s3.bucket }}/galera-{{ cluster.name }}-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::{{ backup.s3.bucket }}/galera-backup-owner.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::{{ backup.s3.bucket }}/drill-state/{{ cluster.name }}.json"
      ]
    }
  ]
}
