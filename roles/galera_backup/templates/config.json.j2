{
  "format_version": 1,
  "cluster_name": "{{ cluster.name }}",
  "metric_cluster_label": "{{ (cluster.monitoring.pmm.cluster_name) if (cluster.monitoring is defined) else monitoring.pmm.cluster_name }}",
  "local_role": "{{ galera_backup_local_role | default('scheduler') }}",
  "scheduler_system_hostname": "{{ backup.scheduler.host }}",
  "scheduler_system_address": "{{ hostvars[backup.scheduler.host].galera_node_address }}",
  {# Wlasny adres wezla: bez niego runner nie odpowie na pytanie "czy to JA
     zostalem wybrany donorem". scheduler_* opisuje PREFERENCJE z cluster.yml,
     nie tozsamosc hosta, na ktorym akurat dziala cron. #}
  "node_system_address": "{{ galera_node_address | default(restore_node_address) | default('') }}",
  "galera_nodes_expected": {{ galera.nodes_expected | default(3) }},
  "galera_nodes": {{ groups['galera'] | map('extract', hostvars, 'galera_node_address') | list | to_json }},
  "mariadb_version": "{{ lock.mariadb.version | default('') }}",
  "retention_days": {{ backup.retention_days | default(14) }},
  "flow_control_threshold_ns": {{ backup.flow_control_threshold_ns | default(1000000000) }},
  "proxysql": {
    "admin_host": "{{ hostvars[groups['proxysql'][0]].proxysql_node_address }}",
    "admin_port": 6032,
    "writer_hostgroup": {{ galera_writer_hg }},
    {# Zdrowe nie-writery. Wg dokumentacji ProxySQL backup_writer_hostgroup
       dostaje wezly read_only=0 ponad max_writers, a niezdrowe ida do
       offline_hostgroup — czyli ONLINE tutaj == kandydat na donora. #}
    "backup_hostgroup": {{ galera_backup_hg }}
  },
  "backend": {
    "type": "{{ backup.destination }}",
{% if backup.destination == 's3' %}
    "endpoint": "{{ backup.s3.endpoint }}",
    "bucket": "{{ backup.s3.bucket }}",
    "secure": {{ backup.s3.secure | default(false) | to_json }}
{% elif backup.destination == 'smb' %}
    "source": "{{ backup.smb.source }}",
    "mount_point": "{{ backup.smb.mount_point }}",
    "options": {{ backup.smb.options | to_json }}
{% elif backup.destination == 'filesystem' %}
    "mount_point": "{{ backup.filesystem.mount_point }}",
    "expected_fstype": "{{ backup.filesystem.expected_fstype }}"
{% endif %}
  },
  "paths": {
    "install_root": "/opt/galera-backup",
    "cluster_dir": "/opt/galera-backup/clusters/{{ cluster.name }}",
    "staging_root": "/var/tmp/galera-backup/{{ cluster.name }}",
    "datadir": "/var/lib/mysql",
    "socket": "/var/lib/mysql/mysql.sock",
    "metric_file": "/var/lib/node_exporter/textfile_collector/galera_backup-{{ cluster.name | regex_replace('[^A-Za-z0-9_-]', '_') }}.prom"
  }
}
