# Galera/MariaDB configuration — generowany z repo (F3)
# Nie wpisuj danych klastra w rolach — wszystko z cluster.yml + inventory.
# Satisfies: ISC-7,8,9,10,14,17 (Galera cluster health)

[mysqld]
# === Podstawowe ===
datadir = /var/lib/mysql
socket = /var/lib/mysql/mysql.sock
pid-file = /run/mariadb/mariadb.pid
user = mysql

# === Galera ===
binlog_format = ROW
default_storage_engine = InnoDB
innodb_autoinc_lock_mode = 2
innodb_flush_log_at_trx_commit = {{ (mariadb_tuning | default({})).innodb_flush_log_at_trx_commit | default(0) }}

# === wsrep ===
wsrep_on = ON
wsrep_provider = /usr/lib64/galera-4/libgalera_smm.so
wsrep_cluster_name = {{ galera_cluster_name }}
wsrep_cluster_address = gcomm://{{ galera_nodes_csv }}
wsrep_node_name = {{ inventory_hostname }}
wsrep_node_address = {{ galera_node_address }}
wsrep_sst_method = mariabackup
wsrep_sst_auth = {{ (sst_user ~ ':' ~ sst_password) | to_json }}

# === Bind ===
bind-address = 0.0.0.0

# === Tuning (produkcja: nadpisz przez mariadb_tuning w cluster.yml; lab: minimalne wartości) ===
innodb_buffer_pool_size = {{ (mariadb_tuning | default({})).innodb_buffer_pool_size | default('256M') }}

# QAN (Query Analytics) w PMM zrodlem danych ma performance_schema. MariaDB — w
# odroznieniu od MySQL — ma je domyslnie WYLACZONE, wiec agenci QAN dzialali, ale
# nie mieli czego zbierac: mysql_perf_schema_events_statements_total mial ZERO
# serii przy dzialajacych metrykach zwyklych. Wlaczamy jawnie.
# KOSZT ZMIERZONY, nie szacowany: SHOW ENGINE PERFORMANCE_SCHEMA STATUS raportuje
# ~105 MB na wezel przy domyslnym sizingu (spojnie na EL9 i EL10, mysqld RSS ~460 MB,
# ~1.85 GB wolnego z 2.7 GB). Parametrem zostaje, bo przy ciasniejszych wezlach
# albo recznie podkreconych tabelach P_S koszt rosnie.
performance_schema = {{ (mariadb_tuning | default({})).performance_schema | default('ON') }}
innodb_log_file_size = {{ (mariadb_tuning | default({})).innodb_log_file_size | default('128M') }}
max_connections = {{ (mariadb_tuning | default({})).max_connections | default(50) }}

# === Logi ===
log_error = /var/log/mariadb/mariadb.log
# Slow log jako ZRODLO DANYCH dla QAN (alternatywa dla performance_schema).
# `pmm-admin add mysql --query-source` domyslnie uzywa `slowlog`, ale wymaga to
# LOKALNEGO agenta czytajacego plik — klaster agentless tej opcji nie ma.
# long_query_time=0 = "loguj wszystko"; celowe dla QAN, ale generuje ruch dyskowy
# (pmm-agent rotuje plik przez --size-slow-logs).
slow_query_log = {{ (mariadb_tuning | default({})).slow_query_log | default('OFF') }}
long_query_time = {{ (mariadb_tuning | default({})).long_query_time | default(10) }}

# === TLS (opcjonalne, per-klaster: tls.mode=full) ===
{% if (tls | default({})).mode | default('disabled') == 'full' %}
ssl_ca = {{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }}
ssl_cert = {{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }}
ssl_key = {{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}
{% if (tls | default({})).require_secure_transport | default(false) %}
require_secure_transport = ON
{% endif %}
{% endif %}

# === gcache (+ szyfrowanie replikacji Galera gdy tls.mode=full) ===
{#
  socket.dynamic pozwala wezlowi przyjmowac ROWNOCZESNIE polaczenia szyfrowane i
  nieszyfrowane. Bez niego wezel z socket.ssl NIE polaczy sie z wezlami bez TLS,
  wiec wlaczenie szyfrowania na dzialajacym klastrze wymagaloby pelnego postoju.
  Musi dac sie ustawic takze przy tls.mode=disabled — to pierwsza z trzech rund
  migracji. Zrodlo: mariadb.com/kb/en/wsrep_provider_options/#socketdynamic
#}
{% set _tls_full = (tls | default({})).mode | default('disabled') == 'full' %}
{% set _wsrep_extra = (mariadb_tuning | default({})).wsrep_provider_options_extra | default('') %}
wsrep_provider_options = "gcache.size={{ gcache_size }};gcache.page_size={{ (mariadb_tuning | default({})).gcache_page_size | default('128M') }}{% if (tls | default({})).socket_dynamic | default(false) %};socket.dynamic=true{% endif %}{% if _tls_full %};socket.ssl_ca={{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }};socket.ssl_cert={{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }};socket.ssl_key={{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}{% endif %}{% if _wsrep_extra | length > 0 %};{{ _wsrep_extra }}{% endif %}"
[client]
socket = /var/lib/mysql/mysql.sock

[sst]
streamfmt = mbstream
{#
  SST nie ma odpowiednika socket.dynamic: dawca i przyjmujacy MUSZA zgadzac sie co
  do szyfrowania, inaczej transfer konczy sie "Broken pipe" i wezel nie wstaje.
  Dlatego szyfrowanie SST wlaczamy dopiero, gdy caly klaster jest juz na TLS —
  czyli gdy socket_dynamic zostalo zdjete (runda 3). W trakcie migracji SST leci
  plaintextem, tak jak u pozostalych wezlow.
#}
{% if _tls_full and not ((tls | default({})).socket_dynamic | default(false)) %}
# audit#7: encrypt=3 WŁĄCZA szyfrowanie strumienia SST (domyślnie 0=plaintext).
# Samo tca/tcert/tkey bez encrypt= zostaje zignorowane — SST leciało czystym tekstem.
encrypt=3
tca = {{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }}
tcert = {{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }}
tkey = {{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}
{% endif %}
