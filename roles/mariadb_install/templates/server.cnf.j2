# Galera/MariaDB configuration — generowany z repo (F3)
# Nie wpisuj danych klastra w rolach — wszystko z cluster.yml + inventory.
# Satisfies: ISC-7,8,9,10,14,17 (Galera cluster health)

[mysqld]
# === Podstawowe ===
datadir = /var/lib/mysql
socket = /var/lib/mysql/mysql.sock
pid-file = /run/mariadb/mariadb.pid
user = mysql

# === Galera ===
binlog_format = ROW
default_storage_engine = InnoDB
innodb_autoinc_lock_mode = 2
innodb_flush_log_at_trx_commit = {{ (mariadb_tuning | default({})).innodb_flush_log_at_trx_commit | default(0) }}

# === wsrep ===
wsrep_on = ON
wsrep_provider = /usr/lib64/galera-4/libgalera_smm.so
wsrep_cluster_name = {{ galera_cluster_name }}
wsrep_cluster_address = gcomm://{{ galera_nodes_csv }}
wsrep_node_name = {{ inventory_hostname }}
wsrep_node_address = {{ galera_node_address }}
wsrep_sst_method = mariabackup
wsrep_sst_auth = {{ (sst_user ~ ':' ~ sst_password) | to_json }}

# === Bind ===
bind-address = 0.0.0.0

# === Tuning (produkcja: nadpisz przez mariadb_tuning w cluster.yml; lab: minimalne wartości) ===
innodb_buffer_pool_size = {{ (mariadb_tuning | default({})).innodb_buffer_pool_size | default('256M') }}
innodb_log_file_size = {{ (mariadb_tuning | default({})).innodb_log_file_size | default('128M') }}
max_connections = {{ (mariadb_tuning | default({})).max_connections | default(50) }}

# === Logi ===
log_error = /var/log/mariadb/mariadb.log
slow_query_log = OFF

# === TLS (opcjonalne, per-klaster: tls.mode=full) ===
{% if (tls | default({})).mode | default('disabled') == 'full' %}
ssl_ca = {{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }}
ssl_cert = {{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }}
ssl_key = {{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}
{% if (tls | default({})).require_secure_transport | default(false) %}
require_secure_transport = ON
{% endif %}
{% endif %}

# === gcache (+ szyfrowanie replikacji Galera gdy tls.mode=full) ===
{% if (tls | default({})).mode | default('disabled') == 'full' %}
wsrep_provider_options = "gcache.size={{ gcache_size }};gcache.page_size={{ (mariadb_tuning | default({})).gcache_page_size | default('128M') }};socket.ssl_ca={{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }};socket.ssl_cert={{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }};socket.ssl_key={{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}"
{% else %}
wsrep_provider_options = "gcache.size={{ gcache_size }};gcache.page_size={{ (mariadb_tuning | default({})).gcache_page_size | default('128M') }}"
{% endif %}

[client]
socket = /var/lib/mysql/mysql.sock

[sst]
streamfmt = mbstream
{% if (tls | default({})).mode | default('disabled') == 'full' %}
tca = {{ tls_ca_path | default('/etc/mysql/tls/ca.pem') }}
tcert = {{ tls_cert_path | default('/etc/mysql/tls/server-cert.pem') }}
tkey = {{ tls_key_path | default('/etc/mysql/tls/server-key.pem') }}
{% endif %}
