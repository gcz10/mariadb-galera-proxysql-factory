# MariaDB backup + restore-drill harmonogram (F10, ISC-37).
# Generowany z repo z cluster.yml: backup.full_backup_schedule / backup.restore_test_schedule.
# Instalowany na hoście zarządzającym (ma repo + dostęp Ansible + sekrety w env / EnvironmentFile).
# Wrapper backup-run.sh dostarcza alert przy porażce (ISC-38).
# flock -n zapobiega nakładającym się uruchomieniom (długi backup + kolejny cron = korupcja stagingu).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# m h dom mon dow  user  command
{{ backup.full_backup_schedule }}  {{ backup_cron_user | default('root') }}  cd {{ backup_repo_dir }} && flock -n /run/mariadb-backup.lock env CLUSTER={{ cluster.name }} BACKUP_SECRETS_FILE={{ backup_secrets_file | default('/etc/mariadb-backup/secrets.env') }} tests/lab/backup-run.sh backup
{{ backup.restore_test_schedule }}  {{ backup_cron_user | default('root') }}  cd {{ backup_repo_dir }} && flock -n /run/mariadb-restore.lock env CLUSTER={{ cluster.name }} BACKUP_SECRETS_FILE={{ backup_secrets_file | default('/etc/mariadb-backup/secrets.env') }} tests/lab/backup-run.sh restore
