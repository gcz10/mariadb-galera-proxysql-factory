# MariaDB backup + restore-drill harmonogram (F10, ISC-37).
# Generowany z repo z cluster.yml: backup.full_backup_schedule / backup.restore_test_schedule.
# Instalowany na hoście zarządzającym (ma repo + dostęp Ansible + sekrety w env).
# Wrapper backup-run.sh dostarcza alert przy porażce (ISC-38).
SHELL=/bin/bash
# m h dom mon dow  user  command
{{ backup.full_backup_schedule }}  {{ backup_cron_user | default('root') }}  cd {{ backup_repo_dir }} && CLUSTER={{ cluster.name }} tests/lab/backup-run.sh backup
{{ backup.restore_test_schedule }}  {{ backup_cron_user | default('root') }}  cd {{ backup_repo_dir }} && CLUSTER={{ cluster.name }} tests/lab/backup-run.sh restore
