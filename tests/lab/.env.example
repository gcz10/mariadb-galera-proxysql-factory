# Przykładowy szablon zmiennych środowiskowych dla środowiska laboratoryjnego / testowego.
# Skopiuj do tests/lab/.env i uzupełnij własnymi poświadczeniami poza repozytorium.
PMM_ADMIN_PASSWORD=change_me_pmm_admin_password
PMM_MONITOR_PASSWORD=change_me_pmm_monitor_password
PROXYSQL_ADMIN_PASSWORD=change_me_proxysql_admin_password
# Konto READ-ONLY (admin-stats_credentials) dla straznika writera w backupie.
# Osobne od admina, bo laduje na dysku wezla Galery.
PROXYSQL_STATS_PASSWORD=change_me_proxysql_stats_password
PROXYSQL_MONITOR_USER=proxysql_monitor
PROXYSQL_MONITOR_PASSWORD=change_me_proxysql_monitor_password
# Nowe haslo uzywane przez `make platform-monitor-rotate`; po udanej rotacji
# przenies te wartosc do PROXYSQL_MONITOR_PASSWORD.
PROXYSQL_MONITOR_PASSWORD_NEXT=change_me_next_proxysql_monitor_password
APP_DB_PASSWORD=change_me_app_db_password
KEEPALIVED_AUTH_PASS=change_me_vrrp_pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
BACKUP_ENCRYPTION_KEY=change_me_backup_encryption_key_32chars
SST_PASSWORD=change_me_sst_password
GALERA_BACKUP_ENCRYPTION_KEY=change_me_galera_backup_encryption_key_32c
